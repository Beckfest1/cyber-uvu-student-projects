# Port for the Express API
PORT=4000

# Option A: a single connection string (takes precedence over the PG* vars).
# DATABASE_URL=postgresql://bm_app:CHANGE_ME@127.0.0.1:5544/thebirthdates

# Option B: individual settings (use the least-privilege bm_app role at runtime).
PGHOST=127.0.0.1
PGPORT=5544
PGUSER=bm_app
PGPASSWORD=CHANGE_ME_STRONG_PASSWORD
PGDATABASE=thebirthdates

# Set to "true" when connecting over TLS (enforces certificate verification).
PGSSL=false
# Optional path to a custom CA certificate bundle when PGSSL=true:
# PGSSLROOTCERT=/path/to/ca.crt

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGIN=http://localhost:5173

# Shared bearer token required by the Express API
API_KEY=CHANGE_ME_STRONG_HEX_TOKEN
